<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; Compose draws everything, so this only sets window behaviour. -->
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Home screen: transparent window that shows the system wallpaper behind it. -->
    <style name="Theme.Launcher.Home">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
